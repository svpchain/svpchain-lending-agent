# Lending Agent deploy settings. This file is sourced by deploy.sh; keep it
# mode 600 because it contains the private DeFi MCP relay credential and may
# contain an LLM API key.

# SSH host with Docker and Compose v2 available without sudo.
SVPCHAIN_DEPLOY_HOST="www@svpdev1.example.com"

# The public URL advertised by the Agent Card. Lending uses its own hostname.
SVPCHAIN_AGENT_PUBLIC_URL="https://agents.svpchain.org"

# The EVM chain used only for broadcast_evm_tx and evm_tx_status.
SVPCHAIN_CHAIN_ID="svp-2517-1"
SVPCHAIN_EVM_RPC="http://127.0.0.1:8545"

# Private DeFi MCP. This credential must match the lending-agent trusted-agent
# entry in svpchain-defi-mcp and must not be shared with another public agent.
SVPCHAIN_DEFI_MCP_URL="http://127.0.0.1:8766/"
SVPCHAIN_LENDING_DEFI_MCP_AUTH_TOKEN="replace-with-lending-agent-secret"

# Optional natural-language read-only Lendora planning. Structured MCP calls
# and EVM transaction broadcast work without this key.
SVPCHAIN_LENDING_AGENT_LLM_PROVIDER="openai"
SVPCHAIN_LENDING_AGENT_LLM_BASE_URL="https://api.deepseek.com"
SVPCHAIN_LENDING_AGENT_LLM_MODEL="deepseek-v4-flash"
SVPCHAIN_LENDING_AGENT_LLM_API_KEY=""

# On-chain registration is local-only. This keyring must be dedicated to this
# Lending Agent; do not reuse the EVM Agent owner or its keyring.
SVPCHAIN_BIN="svpchaind"
SVPCHAIN_LENDING_AGENT_OWNER_KEY_NAME="lending-agent-owner"
SVPCHAIN_LENDING_AGENT_KEYRING_HOME="~/.config/svpchain-lending-agent/keyring"
SVPCHAIN_LENDING_AGENT_KEYRING_BACKEND="file"
# Leave empty for a new owner or when this owner controls only this agent.
# Set the indexed DID (did:svp:svp1...:<index>) only if the owner has more
# than one Agent registration and this script needs to select Lending's record.
SVPCHAIN_LENDING_AGENT_ID=""
SVPCHAIN_REGISTER_RPC="https://svp-devnet.svpchain.org/rpc/"
SVPCHAIN_AGENT_CAPABILITIES="evm.lending,lendora"
SVPCHAIN_AGENT_PRICING_AMOUNT="1000000"
SVPCHAIN_AGENT_PRICING_UNIT="call"
# Registration fee plus sufficient gas. The bond defaults to x/agent MinBond.
SVPCHAIN_REGISTER_FEES="25000000000000000asvp"

# Remote installation directory.
SVPCHAIN_INSTALL_DIR="~/svpchain-lending-agent"
