# Public Lending Agent configuration.
# Lendora contract addresses, assets, and allowed MCP tools are configured in
# the private svpchain-defi-mcp service, not here.

listen_addr = ":8084"
public_url = "http://localhost:8084"

[dex_chain]
id = "svpchain-testnet-1"
evm_rpc_url = "http://127.0.0.1:8545"

[defi_mcp]
url = "http://127.0.0.1:8766/"
auth_token = "replace-with-lending-agent-private-secret"
timeout = "90s"

[llm]
# Optional. The API key stays in this environment variable, not this file.
provider = "openai"
base_url = "https://api.deepseek.com"
model = "deepseek-v4-flash"
api_key_env = "SVPCHAIN_LENDING_AGENT_LLM_API_KEY"
